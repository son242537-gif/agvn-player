AGVN Player: build mkxp-z for Android arm64.
- libmkxp-z.so instead of an executable: Android's SDLActivity loads it and calls SDL_main. SDL is linked whole
  to keep its JNI entry points; only those, JNI_OnLoad and SDL_main are exported (android/exports.map).
- the GNU triplet aarch64-linux-android (Ruby then uses its arm64 coroutines; bionic has no pthread_cancel),
  a soname for FluidSynth, and the NDK's OpenSL ES for OpenAL Soft (no pkg-config file there, so no sound before).

diff --git a/android/exports.map b/android/exports.map
new file mode 100644
index 00000000..e9fc8f84
--- /dev/null
+++ b/android/exports.map
@@ -0,0 +1,9 @@
+/* The symbols Android's SDLActivity needs from libmkxp-z.so; everything else stays inside the library. */
+{
+    global:
+        JNI_OnLoad;
+        Java_*;
+        SDL_main;
+    local:
+        *;
+};
diff --git a/meson.build b/meson.build
index 2b3dc514..d020a42a 100644
--- a/meson.build
+++ b/meson.build
@@ -182,22 +182,42 @@ libmkxp = static_library(
     override_options: {'c_std': c_std, 'cpp_std': cpp_std},
 )
 
-executable(
-    exe_name,
-    sources: [
-        git_hash_file, # Dummy source file just so that Meson doesn't complain about the executable not having any sources
-        windows_resources,
-    ],
-    link_with: libmkxp,
-    include_directories: global_include_dirs,
-    link_args: global_link_args,
-    win_subsystem: 'windows',
-    build_rpath: rpath,
-    install_rpath: rpath,
-    install: true,
-    install_dir: '.',
-    install_tag: meson.project_name(),
-)
+if host_system == 'android'
+    # Android: the app's SDLActivity loads this library and calls SDL_main. SDL is linked whole so that its JNI entry
+    # points stay; only those, JNI_OnLoad and SDL_main are exported.
+    shared_library(
+        meson.project_name(),
+        sources: [git_hash_file],
+        link_whole: [libmkxp, sdl2_lib],
+        include_directories: global_include_dirs,
+        link_args: global_link_args + [
+            '-static-libstdc++',
+            '-Wl,--gc-sections',
+            '-Wl,--version-script=' + meson.project_source_root() / 'android' / 'exports.map',
+        ],
+        link_depends: files('android' / 'exports.map'),
+        install: true,
+        install_dir: '.',
+        install_tag: meson.project_name(),
+    )
+else
+    executable(
+        exe_name,
+        sources: [
+            git_hash_file, # Dummy source file just so that Meson doesn't complain about the executable not having any sources
+            windows_resources,
+        ],
+        link_with: libmkxp,
+        include_directories: global_include_dirs,
+        link_args: global_link_args,
+        win_subsystem: 'windows',
+        build_rpath: rpath,
+        install_rpath: rpath,
+        install: true,
+        install_dir: '.',
+        install_tag: meson.project_name(),
+    )
+endif
 
 global_install_tags = [meson.project_name()]
 if host_system == 'darwin'
