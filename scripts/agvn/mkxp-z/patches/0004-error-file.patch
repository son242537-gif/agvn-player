+++ b/src/util/agvn-error.h
@@ -0,0 +1,30 @@
+/*
+** agvn-error.h
+**
+** AGVN Player (agvn.io): on Android, the app sets AGVN_MKXPZ_ERROR_FILE before the game starts and reads that file
+** after the game ends, so it can tell a game that stopped on an error from one the player quit. Elsewhere: no-op.
+*/
+
+#ifndef AGVN_ERROR_H
+#define AGVN_ERROR_H
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+static inline void agvnReportError(const std::string &msg) {
+#ifdef __ANDROID__
+    const char *path = std::getenv("AGVN_MKXPZ_ERROR_FILE");
+    if (!path || !*path)
+        return;
+    FILE *f = std::fopen(path, "wb");
+    if (!f)
+        return;
+    std::fwrite(msg.data(), 1, msg.size(), f);
+    std::fclose(f);
+#else
+    (void)msg;
+#endif
+}
+
+#endif // AGVN_ERROR_H
