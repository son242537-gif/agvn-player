+String OS_Android::get_godot_dir_name() const {
+	// AGVN Player: "Godot", as on Windows (OS_Windows::get_godot_dir_name), when user:// is under AGVN_GODOT_APPDATA.
+	if (!get_environment("AGVN_GODOT_APPDATA").is_empty()) {
+		return String(GODOT_VERSION_SHORT_NAME).capitalize();
+	}
+	return OS_Unix::get_godot_dir_name();
+}
