+	// AGVN Player: a game made for Windows keeps user:// where Godot keeps it on Windows, %APPDATA%/<p_user_dir>, with
+	// %APPDATA% given in AGVN_GODOT_APPDATA (the AppData/Roaming folder of the game's Wine container). The game then
+	// shares its saves and settings with its Windows version.
+	String agvn_appdata = get_environment("AGVN_GODOT_APPDATA");
+	if (!agvn_appdata.is_empty() && !p_user_dir.is_empty()) {
+		data_dir_cache = agvn_appdata.path_join(p_user_dir);
+		return data_dir_cache;
+	}
+
 	String data_dir = godot_io_java->get_user_data_dir(p_user_dir);
