    <string name="fexcore_env_var_help__halfbarriertsoenabled">启用 TSO 时对非对齐读写使用 half-barrier。</string>
    <string name="fexcore_env_var_help__memcpysettsoenabled">启用 TSO 时让 REP MOVS / REP STOS 成为原子操作。</string>
