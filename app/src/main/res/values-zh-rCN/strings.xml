    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> 将 DirectX 1-11 转换为 OpenGL。<br /><br />
        <i><b>DXVK</b></i> 将 Direct3D 9-11 转换为 Vulkan。<br /><br />
        <i><b>VKD3D</b></i> 将 Direct3D 12 转换为 Vulkan。<br /><br />
        <i><b>CNC DDraw</b></i> 是 DirectDraw 的替代实现，能让老游戏运行得更稳定。
    ]]></string>
    <string name="box64_env_var_help__dynarec_safeflags"><![CDATA[
        CALL/RET 指令的标志位（flags）处理<br /><br />
        <b>0</b> : 视为 CALL/RET 从不需要标志位（更快，但不太稳定）<br />
        <b>1</b> : 大多数 RET 需要标志位，大多数 CALL 不需要<br />
        <b>2</b> : 所有 CALL/RET 都需要标志位（更慢）
    ]]></string>
    <string name="box64_env_var_help__dynarec_fastnan">生成与 x86 相同的 -NAN 值</string>
    <string name="box64_env_var_help__dynarec_fastround">与 x86 一样精确地取整</string>
    <string name="box64_env_var_help__dynarec_x87double">用 Float/Double 模拟 x87</string>
    <string name="box64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec 生成大块（BigBlock）<br /><br />
        <b>0</b> : 不尝试生成尽可能大的块<br />
        <b>1</b> : 生成尽可能大的 Dynarec 块<br />
        <b>2</b> : 生成更大的 Dynarec 块（块重叠时继续，仅限 elf 内存中的块）<br />
        <b>3</b> : 生成更大的 Dynarec 块（块重叠时继续，适用于所有类型的内存）
    ]]></string>
    <string name="box64_env_var_help__dynarec_strongmem"><![CDATA[
        模拟强内存模型（Strong Memory）<br /><br />
        <b>0</b> : 不做特殊处理<br />
        <b>1</b> : 写内存时添加 Memory Barrier（部分 MOV 指令）<br />
        <b>2</b> : 同等级 1，并在每次用 MOV 写内存时添加 Memory Barrier<br />
        <b>3</b> : 同等级 2，并在读内存时和部分 SSE/SSE2 指令中添加 Memory Barrier
    ]]></string>
    <string name="box64_env_var_help__dynarec_forward">生成 Block 时的最大 forward 值</string>
    <string name="box64_env_var_help__dynarec_callret">优化 CALL/RET 指令</string>
    <string name="box64_env_var_help__dynarec_wait">Dynarec 是否等待 FillBlock 就绪</string>
    <string name="box64_env_var_help__dynarec_weakbarrier"><![CDATA[
        调整 memory barrier，减少强内存模拟对性能的影响<br /><br />
        <b>0</b> : 使用常规的安全 barrier<br />
        <b>1</b> : 使用弱 barrier，稍微提升性能<br />
        <b>2</b> : 使用弱 barrier，同时关闭最后一次写入的 barrier]]></string>
    <string name="box64_env_var_help__dynarec_aligned_atomics"><![CDATA[
        只生成对齐的原子（atomic）指令（目前仅限 Arm64）。<br /><br />
        <b>0</b> : 生成可处理非对齐 atomic 的代码。<br />
        <b>1</b> : 只生成对齐的 atomic，更快更精简，但带 LOCK 前缀的指令访问非对齐数据地址时会导致 SIGBUS。]]></string>
    <string name="box64_env_var_help__dynarec_df"><![CDATA[
        开启或关闭延迟标志位（deferred flags）。<br /><br />
        <b>0</b> : 关闭延迟标志位。<br />
        <b>1</b> : 开启延迟标志位。]]></string>
    <string name="box64_env_var_help__dynarec_dirty"><![CDATA[
        允许继续运行未受保护且可能已被修改（dirty）的块。<br /><br />
        <b>0</b> : 不允许继续运行未受保护且可能已被修改的块。<br />
        <b>1</b> : 允许继续运行向代码所在页写入数据的 dynablock。可能让部分游戏加载更快，但也可能导致意外崩溃。<br />
        <b>2</b> : 此外，检测到 HotPage 时会把该页标记为 NEVERCLEAN，该页不再写保护，但由它生成的块始终会被检查。这样可能更快（但可能漏掉某些 SMC 情况）。]]></string>
    <string name="box64_env_var_help__dynarec_nativeflags"><![CDATA[
        开启或关闭原生标志位（native flags）。<br /><br />
        <b>0</b> : 不使用原生标志位。<br />
        <b>1</b> : 尽可能使用原生标志位。]]></string>
    <string name="box64_env_var_help__dynarec_pause"><![CDATA[
        模拟 x86 PAUSE 指令，可能提升 spinlock 的性能。<br /><br />
        <b>0</b> : 忽略 x86 PAUSE 指令。<br />
        <b>1</b> : 用 YIELD 模拟 x86 PAUSE 指令。<br />
        <b>2</b> : 用 WFI 模拟 x86 PAUSE 指令。<br />
        <b>3</b> : 用 SEVL+WFE 模拟 x86 PAUSE 指令。
    ]]></string>
    <string name="box64_env_var_help__avx"><![CDATA[
        支持 AVX 和 AVX2，以及 BMI1、BMI2、ADX、FMA、F16C 和 RDRAND 扩展！<br /><br />
        <b>0</b> : 关闭 AVX<br />
        <b>1</b> : 开启 AVX、BMI1、F16C 和 VAES。<br />
        <b>2</b> : 同等级 1，并加上 AVX2、BMI2、FMA、ADX、VPCLMULQDQ 和 RDRAND。<br />\
    ]]></string>
    <string name="box64_env_var_help__maxcpu">Box64 向程序显示的最大 CPU 数</string>
    <string name="box64_env_var_help__unityplayer">检测到 UnityPlayer.dll 时应用 strongmem 设置</string>
    <string name="box64_env_var_help__mmap32">强制所有分配的内存位于 32 位地址空间内</string>
    <string name="fexcore_env_var_help__tsoenabled">启用 TSO IR 指令（多线程应用需要）。</string>
