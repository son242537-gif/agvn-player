    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> chuyển DirectX 1-11 sang OpenGL.<br /><br />
        <i><b>DXVK</b></i> chuyển Direct3D 9-11 sang Vulkan.<br /><br />
        <i><b>VKD3D</b></i> chuyển Direct3D 12 sang Vulkan.<br /><br />
        <i><b>CNC DDraw</b></i> là bản DirectDraw giúp game cổ chạy ổn định hơn.
    ]]></string>
    <string name="box64_env_var_help__dynarec_safeflags"><![CDATA[
        Xử lý cờ (flags) ở lệnh CALL/RET<br /><br />
        <b>0</b> : Coi như CALL/RET không bao giờ cần cờ (nhanh hơn, kém ổn định)<br />
        <b>1</b> : Đa số RET cần cờ, đa số CALL thì không<br />
        <b>2</b> : Mọi CALL/RET đều cần cờ (chậm hơn)
    ]]></string>
    <string name="box64_env_var_help__dynarec_fastnan">Tạo giá trị -NAN giống như trên x86</string>
    <string name="box64_env_var_help__dynarec_fastround">Làm tròn số chính xác như x86</string>
    <string name="box64_env_var_help__dynarec_x87double">Dùng Float/Double để giả lập x87</string>
    <string name="box64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec tạo khối lớn (BigBlock)<br /><br />
        <b>0</b> : Không cố tạo khối lớn nhất có thể<br />
        <b>1</b> : Tạo khối Dynarec lớn nhất có thể<br />
        <b>2</b> : Tạo khối Dynarec lớn hơn (tiếp tục khi các khối chồng nhau, chỉ với khối trong bộ nhớ elf)<br />
        <b>3</b> : Tạo khối Dynarec lớn hơn (tiếp tục khi các khối chồng nhau, với mọi loại bộ nhớ)
    ]]></string>
    <string name="box64_env_var_help__dynarec_strongmem"><![CDATA[
        Mô phỏng mô hình bộ nhớ mạnh (Strong Memory)<br /><br />
        <b>0</b> : Không làm gì đặc biệt<br />
        <b>1</b> : Thêm Memory Barrier khi ghi bộ nhớ (ở một số lệnh MOV)<br />
        <b>2</b> : Như mức 1, thêm Memory Barrier ở mọi lần ghi bộ nhớ bằng MOV<br />
        <b>3</b> : Như mức 2, thêm Memory Barrier khi đọc bộ nhớ và ở một số lệnh SSE/SSE2
    ]]></string>
    <string name="box64_env_var_help__dynarec_forward">Giá trị forward tối đa khi tạo Block</string>
    <string name="box64_env_var_help__dynarec_callret">Tối ưu lệnh CALL/RET</string>
    <string name="box64_env_var_help__dynarec_wait">Dynarec có chờ FillBlock sẵn sàng hay không</string>
    <string name="box64_env_var_help__dynarec_weakbarrier"><![CDATA[
        Tinh chỉnh memory barrier để giảm ảnh hưởng hiệu năng của giả lập bộ nhớ mạnh<br /><br />
        <b>0</b> : Dùng barrier an toàn thông thường<br />
        <b>1</b> : Dùng barrier yếu để tăng nhẹ hiệu năng<br />
        <b>2</b> : Dùng barrier yếu, đồng thời tắt barrier ở lần ghi cuối]]></string>
    <string name="box64_env_var_help__dynarec_aligned_atomics"><![CDATA[
        Chỉ tạo lệnh nguyên tử (atomic) căn chỉnh (hiện chỉ có trên Arm64).<br /><br />
        <b>0</b> : Tạo mã xử lý atomic không căn chỉnh.<br />
        <b>1</b> : Chỉ tạo atomic căn chỉnh, nhanh và gọn hơn, nhưng sẽ gây SIGBUS với lệnh có tiền tố LOCK trên địa chỉ dữ liệu không căn chỉnh.]]></string>
    <string name="box64_env_var_help__dynarec_df"><![CDATA[
        Bật hoặc tắt cờ trì hoãn (deferred flags).<br /><br />
        <b>0</b> : Tắt cờ trì hoãn.<br />
        <b>1</b> : Bật cờ trì hoãn.]]></string>
    <string name="box64_env_var_help__dynarec_dirty"><![CDATA[
        Cho phép tiếp tục chạy khối không được bảo vệ và có thể đã bị sửa (dirty).<br /><br />
        <b>0</b> : Không cho tiếp tục chạy khối không được bảo vệ và có thể đã bị sửa.<br />
        <b>1</b> : Cho tiếp tục chạy dynablock ghi dữ liệu vào cùng trang với mã. Có thể giúp một số game tải nhanh hơn nhưng cũng có thể gây crash bất ngờ.<br />
        <b>2</b> : Ngoài ra, khi phát hiện HotPage sẽ đánh dấu trang đó là NEVERCLEAN, nên trang không bị chống ghi nhưng khối tạo từ trang đó luôn được kiểm tra. Cách này có thể nhanh hơn (nhưng một số trường hợp SMC có thể bị bỏ sót).]]></string>
    <string name="box64_env_var_help__dynarec_nativeflags"><![CDATA[
        Bật hoặc tắt cờ gốc (native flags).<br /><br />
        <b>0</b> : Không dùng cờ gốc.<br />
        <b>1</b> : Dùng cờ gốc khi có thể.]]></string>
    <string name="box64_env_var_help__dynarec_pause"><![CDATA[
        Giả lập lệnh x86 PAUSE, có thể giúp hiệu năng của spinlock.<br /><br />
        <b>0</b> : Bỏ qua lệnh x86 PAUSE.<br />
        <b>1</b> : Dùng YIELD để giả lập lệnh x86 PAUSE.<br />
        <b>2</b> : Dùng WFI để giả lập lệnh x86 PAUSE.<br />
        <b>3</b> : Dùng SEVL+WFE để giả lập lệnh x86 PAUSE.
    ]]></string>
    <string name="box64_env_var_help__avx"><![CDATA[
        Hỗ trợ AVX và AVX2, cùng các tiện ích BMI1, BMI2, ADX, FMA, F16C và RDRAND!<br /><br />
        <b>0</b> : Tắt AVX<br />
        <b>1</b> : Bật AVX, BMI1, F16C và VAES.<br />
        <b>2</b> : Như mức 1, thêm AVX2, BMI2, FMA, ADX, VPCLMULQDQ và RDRAND.<br />\
    ]]></string>
