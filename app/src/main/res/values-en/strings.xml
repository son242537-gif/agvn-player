    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> turns DirectX 1-11 into OpenGL.<br /><br />
        <i><b>DXVK</b></i> turns Direct3D 9-11 into Vulkan.<br /><br />
        <i><b>VKD3D</b></i> turns Direct3D 12 into Vulkan.<br /><br />
        <i><b>CNC DDraw</b></i> is a DirectDraw version that helps old games run more stably.
    ]]></string>
    <string name="box64_env_var_help__dynarec_safeflags"><![CDATA[
        Handling of flags on CALL/RET instructions<br /><br />
        <b>0</b> : Treat CALL/RET as never needing flags (faster, less stable)<br />
        <b>1</b> : Most RET need flags, most CALL do not<br />
        <b>2</b> : All CALL/RET need flags (slower)
    ]]></string>
    <string name="box64_env_var_help__dynarec_fastnan">Generate -NAN like on x86</string>
    <string name="box64_env_var_help__dynarec_fastround">Round numbers exactly like x86</string>
    <string name="box64_env_var_help__dynarec_x87double">Use Float/Double to emulate x87</string>
    <string name="box64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec builds big blocks (BigBlock)<br /><br />
        <b>0</b> : Do not try to build blocks as big as possible<br />
        <b>1</b> : Build Dynarec blocks as big as possible<br />
        <b>2</b> : Build bigger Dynarec blocks (continue when blocks overlap, only for blocks in elf memory)<br />
        <b>3</b> : Build bigger Dynarec blocks (continue when blocks overlap, for all memory types)
    ]]></string>
    <string name="box64_env_var_help__dynarec_strongmem"><![CDATA[
        Simulate the strong memory model (Strong Memory)<br /><br />
        <b>0</b> : Do nothing special<br />
        <b>1</b> : Add a Memory Barrier when writing memory (on some MOV instructions)<br />
        <b>2</b> : Like level 1, plus a Memory Barrier on every memory write with MOV<br />
        <b>3</b> : Like level 2, plus a Memory Barrier when reading memory and on some SSE/SSE2 instructions
    ]]></string>
    <string name="box64_env_var_help__dynarec_forward">Maximum forward value when building a Block</string>
    <string name="box64_env_var_help__dynarec_callret">Optimize CALL/RET instructions</string>
    <string name="box64_env_var_help__dynarec_wait">Whether Dynarec waits for FillBlock to be ready</string>
    <string name="box64_env_var_help__dynarec_weakbarrier"><![CDATA[
        Tune memory barriers to reduce the performance cost of strong memory emulation<br /><br />
        <b>0</b> : Use normal safe barriers<br />
        <b>1</b> : Use weak barriers for a slight performance boost<br />
        <b>2</b> : Use weak barriers, and also turn off the last write barrier]]></string>
    <string name="box64_env_var_help__dynarec_aligned_atomics"><![CDATA[
        Generate aligned atomic instructions only (currently Arm64 only).<br /><br />
        <b>0</b> : Generate code that handles unaligned atomics.<br />
        <b>1</b> : Generate aligned atomics only, faster and smaller, but causes SIGBUS for LOCK-prefixed instructions on unaligned data addresses.]]></string>
    <string name="box64_env_var_help__dynarec_df"><![CDATA[
        Turn deferred flags on or off.<br /><br />
        <b>0</b> : Deferred flags off.<br />
        <b>1</b> : Deferred flags on.]]></string>
    <string name="box64_env_var_help__dynarec_dirty"><![CDATA[
        Allow running on in a block that is unprotected and may have been modified (dirty).<br /><br />
        <b>0</b> : Do not run on in blocks that are unprotected and may have been modified.<br />
        <b>1</b> : Run on in dynablocks that write data in the same page as code. May help some games load faster, but can also cause unexpected crashes.<br />
        <b>2</b> : Also, when a HotPage is detected, mark that page NEVERCLEAN, so the page is not write-protected but blocks built from it are always checked. This can be faster (but some SMC cases may be missed).]]></string>
    <string name="box64_env_var_help__dynarec_nativeflags"><![CDATA[
        Turn native flags on or off.<br /><br />
        <b>0</b> : Do not use native flags.<br />
        <b>1</b> : Use native flags when possible.]]></string>
    <string name="box64_env_var_help__dynarec_pause"><![CDATA[
        Emulate the x86 PAUSE instruction, may help spinlock performance.<br /><br />
        <b>0</b> : Ignore the x86 PAUSE instruction.<br />
        <b>1</b> : Use YIELD to emulate the x86 PAUSE instruction.<br />
        <b>2</b> : Use WFI to emulate the x86 PAUSE instruction.<br />
        <b>3</b> : Use SEVL+WFE to emulate the x86 PAUSE instruction.
    ]]></string>
    <string name="box64_env_var_help__avx"><![CDATA[
        AVX and AVX2 support, plus the BMI1, BMI2, ADX, FMA, F16C and RDRAND extensions!<br /><br />
        <b>0</b> : AVX off<br />
        <b>1</b> : Turn on AVX, BMI1, F16C and VAES.<br />
        <b>2</b> : Like level 1, plus AVX2, BMI2, FMA, ADX, VPCLMULQDQ and RDRAND.<br />\
    ]]></string>
    <string name="box64_env_var_help__maxcpu">Maximum number of CPUs Box64 shows to programs</string>
    <string name="box64_env_var_help__unityplayer">Detect UnityPlayer.dll and apply strongmem settings</string>
    <string name="box64_env_var_help__mmap32">Force all memory allocations into the 32-bit address space</string>
    <string name="fexcore_env_var_help__tsoenabled">Turns on TSO IR instructions (needed for multithreaded apps).</string>
    <string name="fexcore_env_var_help__vectortsoenabled">Atomic vector loads/stores when TSO is on.</string>
    <string name="fexcore_env_var_help__halfbarriertsoenabled">Use half-barriers for unaligned loads/stores when TSO is on.</string>
    <string name="fexcore_env_var_help__memcpysettsoenabled">Make REP MOVS / REP STOS atomic when TSO is on.</string>
    <string name="fexcore_env_var_help__multiblock">Compile several code blocks at once. Can make JIT compiling take longer and cause stutter.</string>
    <string name="fexcore_env_var_help__hostfeatures">Controls forcing of CPU features.</string>
    <string name="fexcore_env_var_help__smalltscscale">Adjusts TSC on low-frequency machines.</string>
    <string name="fexcore_env_var_help__smc_checks">Self-modifying code (SMC) checks.</string>
    <string name="fexcore_env_var_help__volatilemetadata">Use volatile metadata from PE files for TSO when available.</string>
    <string name="fexcore_env_var_help__monohacks">SMC + separate JIT block tricks when Mono is detected.</string>
    <string name="fexcore_env_var_help__hidehypervisorbit">Hide the CPUID hypervisor bit (helps apps that crash because of it).</string>
    <string name="fexcore_env_var_help__disablel2cache">Turn off the FEXCore JIT L2 cache lookup: saves memory but causes stutter.</string>
    <string name="fexcore_env_var_help__dynamicl1cache">Let the FEXCore JIT L1 cache resize itself: saves memory but causes stutter.</string>
    <string name="fexcore_env_var_help__x87reducedprecision">Emulate X87 floating point with 64-bit precision. Less accurate and may cause visual glitches.</string>
