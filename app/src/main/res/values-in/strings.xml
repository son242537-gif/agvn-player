    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> mengubah DirectX 1-11 ke OpenGL.<br /><br />
        <i><b>DXVK</b></i> mengubah Direct3D 9-11 ke Vulkan.<br /><br />
        <i><b>VKD3D</b></i> mengubah Direct3D 12 ke Vulkan.<br /><br />
        <i><b>CNC DDraw</b></i> adalah DirectDraw pengganti yang membuat game lawas berjalan lebih stabil.
    ]]></string>
    <string name="box64_env_var_help__dynarec_safeflags"><![CDATA[
        Penanganan flag pada instruksi CALL/RET<br /><br />
        <b>0</b> : Anggap CALL/RET tidak pernah butuh flag (lebih cepat, kurang stabil)<br />
        <b>1</b> : Sebagian besar RET butuh flag, sebagian besar CALL tidak<br />
        <b>2</b> : Semua CALL/RET butuh flag (lebih lambat)
    ]]></string>
    <string name="box64_env_var_help__dynarec_fastnan">Buat nilai -NAN seperti di x86</string>
    <string name="box64_env_var_help__dynarec_fastround">Bulatkan angka persis seperti x86</string>
    <string name="box64_env_var_help__dynarec_x87double">Gunakan Float/Double untuk emulasi x87</string>
    <string name="box64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec membuat blok besar (BigBlock)<br /><br />
        <b>0</b> : Tidak berusaha membuat blok sebesar mungkin<br />
        <b>1</b> : Buat blok Dynarec sebesar mungkin<br />
        <b>2</b> : Buat blok Dynarec lebih besar (lanjut saat blok tumpang tindih, hanya untuk blok di memori elf)<br />
        <b>3</b> : Buat blok Dynarec lebih besar (lanjut saat blok tumpang tindih, untuk semua jenis memori)
    ]]></string>
    <string name="box64_env_var_help__dynarec_strongmem"><![CDATA[
        Emulasi model memori kuat (Strong Memory)<br /><br />
        <b>0</b> : Tidak melakukan hal khusus<br />
        <b>1</b> : Tambah Memory Barrier saat menulis memori (pada beberapa instruksi MOV)<br />
        <b>2</b> : Seperti level 1, tambah Memory Barrier pada setiap penulisan memori dengan MOV<br />
        <b>3</b> : Seperti level 2, tambah Memory Barrier saat membaca memori dan pada beberapa instruksi SSE/SSE2
    ]]></string>
    <string name="box64_env_var_help__dynarec_forward">Nilai forward maksimum saat membuat Block</string>
    <string name="box64_env_var_help__dynarec_callret">Optimalkan instruksi CALL/RET</string>
    <string name="box64_env_var_help__dynarec_wait">Apakah Dynarec menunggu FillBlock siap</string>
    <string name="box64_env_var_help__dynarec_weakbarrier"><![CDATA[
        Atur memory barrier untuk mengurangi dampak performa dari emulasi memori kuat<br /><br />
        <b>0</b> : Gunakan barrier aman biasa<br />
        <b>1</b> : Gunakan barrier lemah untuk sedikit menambah performa<br />
        <b>2</b> : Gunakan barrier lemah, sekaligus matikan barrier pada penulisan terakhir]]></string>
    <string name="box64_env_var_help__dynarec_aligned_atomics"><![CDATA[
        Hanya buat instruksi atomik (atomic) yang sejajar (saat ini hanya di Arm64).<br /><br />
        <b>0</b> : Buat kode penanganan atomic yang tidak sejajar.<br />
        <b>1</b> : Hanya buat atomic sejajar, lebih cepat dan ringkas, tetapi akan memicu SIGBUS pada instruksi berawalan LOCK di alamat data yang tidak sejajar.]]></string>
    <string name="box64_env_var_help__dynarec_df"><![CDATA[
        Aktifkan atau matikan flag tertunda (deferred flags).<br /><br />
        <b>0</b> : Matikan flag tertunda.<br />
        <b>1</b> : Aktifkan flag tertunda.]]></string>
    <string name="box64_env_var_help__dynarec_dirty"><![CDATA[
        Izinkan lanjut menjalankan blok yang tidak dilindungi dan mungkin sudah diubah (dirty).<br /><br />
        <b>0</b> : Jangan lanjut menjalankan blok yang tidak dilindungi dan mungkin sudah diubah.<br />
        <b>1</b> : Lanjut menjalankan dynablock yang menulis data ke halaman yang sama dengan kode. Bisa membuat sebagian game memuat lebih cepat, tetapi juga bisa menyebabkan crash tak terduga.<br />
        <b>2</b> : Selain itu, saat mendeteksi HotPage, halaman itu ditandai NEVERCLEAN, sehingga halaman tidak dilindungi dari penulisan tetapi blok dari halaman itu selalu diperiksa. Cara ini bisa lebih cepat (tetapi beberapa kasus SMC bisa terlewat).]]></string>
    <string name="box64_env_var_help__dynarec_nativeflags"><![CDATA[
        Aktifkan atau matikan flag native (native flags).<br /><br />
        <b>0</b> : Jangan gunakan flag native.<br />
        <b>1</b> : Gunakan flag native jika bisa.]]></string>
    <string name="box64_env_var_help__dynarec_pause"><![CDATA[
        Emulasi instruksi x86 PAUSE, bisa membantu performa spinlock.<br /><br />
        <b>0</b> : Abaikan instruksi x86 PAUSE.<br />
        <b>1</b> : Gunakan YIELD untuk emulasi instruksi x86 PAUSE.<br />
        <b>2</b> : Gunakan WFI untuk emulasi instruksi x86 PAUSE.<br />
        <b>3</b> : Gunakan SEVL+WFE untuk emulasi instruksi x86 PAUSE.
    ]]></string>
    <string name="box64_env_var_help__avx"><![CDATA[
        Dukungan AVX dan AVX2, serta ekstensi BMI1, BMI2, ADX, FMA, F16C dan RDRAND!<br /><br />
        <b>0</b> : Matikan AVX<br />
        <b>1</b> : Aktifkan AVX, BMI1, F16C dan VAES.<br />
        <b>2</b> : Seperti level 1, tambah AVX2, BMI2, FMA, ADX, VPCLMULQDQ dan RDRAND.<br />\
    ]]></string>
